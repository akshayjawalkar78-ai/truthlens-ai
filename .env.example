# Configuration for Live Analysis Mode
# When an API key is provided, Verity can perform live AI-powered media analysis.
# If left blank or unset, Verity operates in fully offline Judge-Ready Demo Mode.

# Option 1: Google Gemini API (Recommended)
GEMINI_API_KEY=

# Option 2: OpenAI API (Alternative)
OPENAI_API_KEY=

# Optional: Tavily or Serper API for live web search and source retrieval
SEARCH_API_KEY=
